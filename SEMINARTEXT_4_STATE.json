    "decision_record": "decisions/0001-operating-model-and-human-gates.md",
    "github_source_of_truth": {
      "roadmap": "SEMINARTEXT_4_ROADMAP.md",
      "state": "SEMINARTEXT_4_STATE.json",
      "issues": "task contracts and Definitions of Done",
      "pull_requests": "implementation, evidence, review, and merge decisions",
      "tests_and_benchmarks": "executable evidence",
      "decisions": "decisions/"
    },
    "standard_execution_loop": "ROADMAP -> PO ISSUE/DoD -> CODEX IMPLEMENT -> AUTOMATED TEST/QA -> PR -> PO REVIEW -> [DOMAIN GATE only if needed] -> MERGE -> STATE/ROADMAP UPDATE -> NEXT ISSUE",
    "experimental_ml_loop": "BUILD -> TEST -> BENCHMARK -> HUMAN REVIEW when semantically required -> DECISION -> MERGE"
  },
  "human_gate_classifications": {
    "default": "AUTO",
    "values": {
      "AUTO": "Proceed without Yuri when automated QA and Product Owner review are sufficient.",
      "DOMAIN_REVIEW": "Yuri reviews prepared evidence/options before acceptance.",
      "DOMAIN_AUTHORING": "Yuri supplies authoritative semantic content such as Gold labels.",
      "LOCAL_ACTION": "Yuri performs a local/UI/account action unavailable to tools."
    }
  },
  "roles": {
    "product_owner": {
      "owner": "ChatGPT",
      "responsibilities": [
        "roadmap and priorities",
        "issue sequencing and Definition of Done",
        "experiment evidence and PR review",
        "accept/reject work and merge/next-step decisions",
        "escalate to Yuri only when domain/product/human decision is required"
      ]
    },
    "domain_owner": {
      "owner": "Yuri",
      "required_for": [
        "semantic Gold labeling and disputed topic boundaries",
        "authoritative terminology and author-methodology meaning",
        "genuinely ambiguous interpretations",
        "product/business decisions that cannot be inferred safely",
        "acceptance of conceptual model changes",
        "local-machine actions unavailable to tools"
      ],
      "not_normally_required_for": [
        "copying requirements between ChatGPT, GitHub, and Codex",
        "routine coding/test/branch/commit/PR mechanics",
        "routine benchmark aggregation",
        "routine documentation updates",
        "automatable technical QA"
      ]
    },
    "codex": {
      "responsibilities": [
        "read GitHub Issue as task contract",
        "implement within scope",
        "run tests and QA",
        "document evidence",
        "commit, push, and open PR",
        "do not redefine requirements or bypass human gates"
      ]
    }
  }
