  "test_policy": {
    "command": [
      "{test_python}",
      "-m",
      "pytest",
      "-q",
      "-rs",
      "-p",
      "no:cacheprovider"
    ],
    "skip_policy": "WARN_WHEN_ACTIVE_RUNTIME_IS_NOT_REBUILT_FROM_DEV_PROFILE",
    "known_current_limitation": "The shared runtime may retain visible jsonschema skips until it is rebuilt from requirements-dev.txt; the isolated dev profile resolves them without global mutation."
  },
  "gates": [
    {
      "id": "G1",
      "name": "Git Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "Repository identity, cleanliness, origin/main relation, and required tracked runtime source are truthful."
    },
    {
      "id": "G2",
      "name": "Runtime Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "Any detected installed runtime is complete, byte-identical to repository-governed runtime source, and can dispatch Evidence Foundation, Project Knowledge bridge, and Dataset Governance CLI paths without missing-module/import errors."
    },
    {
      "id": "G3",
      "name": "Governance Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "The repository governance checker is read-only; the canonical Product Rules Registry, stable IDs, lifecycle, supersession structure, operating control loop, and accepted decisions, dispositions, and human-gate lifecycle truth reconcile against repository contracts."
    },
    {
      "id": "G4",
      "name": "Dependency Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "Each accepted profile has a pinned manifest/lock, documented Python runtime, and model drift metadata."
    },
    {
      "id": "G5",
      "name": "Canonical Contract Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "Accepted Canonical Evidence v1 and Canonical Knowledge v1 schemas, stable IDs, references, provenance, lifecycle, lineage, source pointers, and Golden Slice compatibility are validated fail-closed."
    },
    {
      "id": "G6",
      "name": "End-to-End Truth",
      "implementation": "NOT_IMPLEMENTED",
      "blocking_policy": "future_blocking",
      "reason": "Future gate requires an explicit supported end-to-end fixture; expensive ML/model execution is outside v1."
    },
    {
      "id": "G7",
      "name": "Test Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "The supported full pytest command is executed; failures and skips are never hidden."
    },
    {
      "id": "G8",
      "name": "Product State Truth",
      "implementation": "IMPLEMENTED",
      "blocking_policy": "blocking",
      "invariant": "Version, product maturity, current milestone, next actions, blocked work, and runtime-reconciliation readiness do not contradict the offline milestone contract."
    }
  ]
}
