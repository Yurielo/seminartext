{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seminartext.local/schemas/issue_68_batch_review_v1.schema.json",
  "title": "Issue #68 batch DOMAIN_REVIEW transport",
  "oneOf": [
    {"$ref": "#/$defs/package"},
    {"$ref": "#/$defs/submission"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "range": {
      "type": "object",
      "required": ["start_word_id", "end_word_id"],
      "properties": {
        "start_word_id": {"$ref": "#/$defs/id"},
        "end_word_id": {"$ref": "#/$defs/id"}
      }
    },
    "evidence_range": {
      "allOf": [{"$ref": "#/$defs/range"}],
      "required": ["source_revision_id", "evidence_sha256", "exact_pattern_match_count"],
      "properties": {
        "source_revision_id": {"$ref": "#/$defs/id"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "exact_pattern_match_count": {"type": "integer", "minimum": 0}
      }
    },
    "link": {
      "type": "object",
      "required": ["link_id", "topic_id", "topic_title", "concept_id", "concept_label", "source_id", "source_revision_id", "evidence_sha256", "evidence_ranges", "topic_range", "canonical_evidence_reference", "exception_reason", "mention_excerpt", "exact_mentions_in_evidence", "evidence_complete", "explanation_ru", "available_decisions", "group", "governed_link_snapshot", "deferred"],
      "properties": {
        "link_id": {"$ref": "#/$defs/id"},
        "topic_id": {"$ref": "#/$defs/id"},
        "topic_title": {"type": "string", "minLength": 1},
        "concept_id": {"$ref": "#/$defs/id"},
        "concept_label": {"type": "string", "minLength": 1},
        "source_id": {"$ref": "#/$defs/id"},
        "source_revision_id": {"$ref": "#/$defs/id"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ranges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_range"}},
        "topic_range": {"$ref": "#/$defs/range"},
        "canonical_evidence_reference": {"const": "evidence/canonical_bundle.json"},
        "exception_reason": {"type": "string", "minLength": 1},
        "mention_excerpt": {"type": "string", "minLength": 1},
        "exact_mentions_in_evidence": {"type": "integer", "minimum": 0},
        "evidence_complete": {"const": true},
        "explanation_ru": {"type": "string", "minLength": 1},
        "available_decisions": {"const": ["ACCEPT", "REJECT", "REASSIGN", "DEFER"]},
        "group": {"type": "object"},
        "governed_link_snapshot": {"type": "object"},
        "deferred": {"type": "boolean"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "semantic_authority", "qa_sha256", "canonical_evidence_sha256", "decision_ledger_sha256", "active", "deferred", "groups"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_type": {"const": "seminartext.issue_68_batch_domain_review"},
        "semantic_authority": {"const": "PROVISIONAL_UNREVIEWED"},
        "qa_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "decision_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "active": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "deferred": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "groups": {
          "type": "object",
          "additionalProperties": false,
          "required": ["concept", "source", "reason", "topic_lineage"],
          "properties": {
            "concept": {"$ref": "#/$defs/group_index"},
            "source": {"$ref": "#/$defs/group_index"},
            "reason": {"$ref": "#/$defs/group_index"},
            "topic_lineage": {"$ref": "#/$defs/group_index"}
          }
        }
      }
    },
    "group_index": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/id"}}},
    "submission_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "topic_id", "concept_id", "source_revision_id", "evidence_sha256", "review_package_sha256", "action", "human_confirmed", "governed_decision"],
      "properties": {
        "link_id": {"$ref": "#/$defs/id"},
        "topic_id": {"$ref": "#/$defs/id"},
        "concept_id": {"$ref": "#/$defs/id"},
        "source_revision_id": {"$ref": "#/$defs/id"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "review_package_sha256": {"$ref": "#/$defs/sha256"},
        "action": {"enum": ["ACCEPT", "REJECT", "REASSIGN", "DEFER"]},
        "human_confirmed": {"const": true},
        "governed_decision": {
          "type": "object",
          "required": ["decision_id", "authority", "outcome", "target_link_id", "link_snapshot"],
          "properties": {
            "decision_id": {"$ref": "#/$defs/id"},
            "authority": {"const": "PRODUCT_OWNER_DOMAIN_REVIEW"},
            "outcome": {"enum": ["ACCEPT_LINK", "REJECT_LINK", "REMAP_LINK", "DEFER_LINK"]},
            "target_link_id": {"$ref": "#/$defs/id"},
            "link_snapshot": {"type": "object"}
          }
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_package_sha256", "decision_ledger_sha256", "decisions"],
      "properties": {
        "review_package_sha256": {"$ref": "#/$defs/sha256"},
        "decision_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/submission_entry"}}
      }
    }
  }
}
