{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seminartext.local/schemas/project_knowledge_input_v1.schema.json",
  "title": "SeminarText Project Knowledge Input v1",
  "description": "Explicit semantic input for the project knowledge bridge. Canonical Knowledge entity records are validated again after compilation by canonical_knowledge_v1.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project",
    "seminars",
    "topics",
    "concepts",
    "relations",
    "review_decisions",
    "relation_type_registry",
    "topic_sources",
    "evidence",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "seminartext.project_knowledge_input"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "project": {"type": "object"},
    "seminars": {"type": "array", "items": {"type": "object"}},
    "topics": {"type": "array", "items": {"type": "object"}},
    "concepts": {"type": "array", "items": {"type": "object"}},
    "relations": {"type": "array", "items": {"type": "object"}},
    "review_decisions": {"type": "array", "items": {"type": "object"}},
    "relation_type_registry": {"type": "array", "items": {"type": "object"}},
    "topic_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/topic_source"}
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "topic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_id", "topic_set_id", "sequence", "origin", "transcript_revision_id", "word_start_id", "word_end_id"],
      "properties": {
        "topic_id": {"$ref": "#/$defs/id"},
        "topic_set_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "origin": {"enum": ["gold", "verified_manual", "semi_automatic"]},
        "transcript_revision_id": {"$ref": "#/$defs/id"},
        "word_start_id": {"$ref": "#/$defs/id"},
        "word_end_id": {"$ref": "#/$defs/id"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "source_id", "transcript_revision_id", "word_start_id", "word_end_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claim": {"type": "string", "minLength": 1},
        "source_id": {"$ref": "#/$defs/id"},
        "transcript_revision_id": {"$ref": "#/$defs/id"},
        "word_start_id": {"$ref": "#/$defs/id"},
        "word_end_id": {"$ref": "#/$defs/id"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "reason"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["COVERED", "SEMANTIC_INPUT_UNAVAILABLE", "NOT_IN_SCOPE"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
