{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seminartext.local/schemas/selected_whisper_timing_v1.schema.json",
  "title": "SeminarText selected Whisper timing manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "seminartext_version",
    "source",
    "transcription",
    "parts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "seminartext.selected_whisper_timing"},
    "seminartext_version": {"type": "string", "pattern": "^4\\.[0-9]+\\.[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "reference_sha256", "media_sha256"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "media_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "mode", "chunk_seconds", "whisper_model", "vad_model"],
      "properties": {
        "language": {"enum": ["ru", "en"]},
        "mode": {"enum": ["normal", "careful"]},
        "chunk_seconds": {"type": "integer", "minimum": 1},
        "whisper_model": {"$ref": "#/$defs/model"},
        "vad_model": {"$ref": "#/$defs/model"}
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^parts/part_[0-9]{4}\\.(txt|srt|json)$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "absolute_offset_seconds",
        "absolute_range",
        "selected_attempt",
        "speech_detected",
        "artifacts"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^part_[0-9]{4}$"},
        "order": {"type": "integer", "minimum": 0},
        "absolute_offset_seconds": {"type": "number", "minimum": 0},
        "absolute_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_seconds", "end_seconds"],
          "properties": {
            "start_seconds": {"type": "number", "minimum": 0},
            "end_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "selected_attempt": {"enum": ["initial", "retry"]},
        "speech_detected": {"type": "boolean"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["txt", "srt", "json_full"],
          "properties": {
            "txt": {"$ref": "#/$defs/artifact"},
            "srt": {"$ref": "#/$defs/artifact"},
            "json_full": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    }
  }
}
