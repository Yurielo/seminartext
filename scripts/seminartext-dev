#!/bin/bash
set -Eeuo pipefail

REPO="${SEMINARTEXT_DEV_REPO:-$HOME/Documents/seminartext}"
BIN="${SEMINARTEXT_DEV_BIN:-$HOME/bin}"
BACKUP_ROOT="${SEMINARTEXT_DEV_BACKUP_ROOT:-$HOME/.seminartext-deploy-backups}"

CODE="$REPO/seminartext"
ROADMAP="$REPO/SEMINARTEXT_4_ROADMAP.md"
STATE="$REPO/SEMINARTEXT_4_STATE.json"
TOPICS="$REPO/seminartext_modules/seminartext_topics.py"
TRANSLATE="$REPO/seminartext_modules/seminartext_translate.py"
EVIDENCE_FOUNDATION="$REPO/seminartext_modules/evidence_foundation.py"
PROJECT_KNOWLEDGE_BRIDGE="$REPO/seminartext_modules/project_knowledge_bridge.py"
HUMAN_REVIEW_WORKFLOW="$REPO/seminartext_modules/human_review_workflow.py"
OWNED_TMP="$REPO/seminartext_modules/owned_tmp.py"
GROUP_SOURCES="$REPO/seminartext_modules/group_sources.py"
ASR_COMPLETION="$REPO/seminartext_modules/asr_completion.py"
CANONICAL_VALIDATOR="$REPO/schemas/validate_canonical_evidence_v1.py"
CANONICAL_SCHEMA="$REPO/schemas/canonical_evidence_v1.schema.json"
CANONICAL_KNOWLEDGE_VALIDATOR="$REPO/schemas/validate_canonical_knowledge_v1.py"
CANONICAL_KNOWLEDGE_SCHEMA="$REPO/schemas/canonical_knowledge_v1.schema.json"
CANONICAL_KNOWLEDGE_LIFECYCLE="$REPO/schemas/canonical_knowledge_lifecycle_v1.json"
PROJECT_KNOWLEDGE_INPUT_SCHEMA="$REPO/schemas/project_knowledge_input_v1.schema.json"
TOPIC_REVIEW_WORKFLOW_SCHEMA="$REPO/schemas/topic_review_workflow_v1.schema.json"
TOPIC_REVIEW_WORKFLOW_SCHEMA_V2="$REPO/schemas/topic_review_workflow_v2.schema.json"
DATASET_GOVERNANCE="$REPO/seminartext_modules/dataset_governance.py"
DATASET_REGISTRY="$REPO/governance/dataset_registry.json"
TOPIC_ENGINE_GOVERNANCE="$REPO/seminartext_modules/topic_engine_governance.py"
TOPIC_ENGINE_LIFECYCLE="$REPO/governance/topic_engine_lifecycle.json"
TOPIC_ENGINE_FREEZE="$REPO/governance/topic_engine_freeze.json"
VERSION_FILE="$REPO/SEMINARTEXT_VERSION"
GOVERNANCE_CHECK="$REPO/scripts/check_governance.py"

DEPLOY_CODE="$BIN/seminartext_4.0_work"
DEPLOY_ROADMAP="$BIN/SEMINARTEXT_4_ROADMAP.md"
DEPLOY_STATE="$BIN/SEMINARTEXT_4_STATE.json"
DEPLOY_TOPICS="$BIN/seminartext_topics.py"
DEPLOY_TRANSLATE="$BIN/seminartext_translate.py"
DEPLOY_EVIDENCE_FOUNDATION="$BIN/seminartext_modules/evidence_foundation.py"
DEPLOY_PROJECT_KNOWLEDGE_BRIDGE="$BIN/seminartext_modules/project_knowledge_bridge.py"
DEPLOY_HUMAN_REVIEW_WORKFLOW="$BIN/seminartext_modules/human_review_workflow.py"
DEPLOY_OWNED_TMP="$BIN/seminartext_modules/owned_tmp.py"
DEPLOY_GROUP_SOURCES="$BIN/seminartext_modules/group_sources.py"
DEPLOY_ASR_COMPLETION="$BIN/seminartext_modules/asr_completion.py"
DEPLOY_CANONICAL_VALIDATOR="$BIN/schemas/validate_canonical_evidence_v1.py"
DEPLOY_CANONICAL_SCHEMA="$BIN/schemas/canonical_evidence_v1.schema.json"
DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR="$BIN/schemas/validate_canonical_knowledge_v1.py"
DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA="$BIN/schemas/canonical_knowledge_v1.schema.json"
DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE="$BIN/schemas/canonical_knowledge_lifecycle_v1.json"
DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA="$BIN/schemas/project_knowledge_input_v1.schema.json"
DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA="$BIN/schemas/topic_review_workflow_v1.schema.json"
DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2="$BIN/schemas/topic_review_workflow_v2.schema.json"
DEPLOY_DATASET_GOVERNANCE="$BIN/seminartext_modules/dataset_governance.py"
DEPLOY_DATASET_REGISTRY="$BIN/governance/dataset_registry.json"
DEPLOY_TOPIC_ENGINE_GOVERNANCE="$BIN/seminartext_modules/topic_engine_governance.py"
DEPLOY_TOPIC_ENGINE_LIFECYCLE="$BIN/governance/topic_engine_lifecycle.json"
DEPLOY_TOPIC_ENGINE_FREEZE="$BIN/governance/topic_engine_freeze.json"
DEPLOY_VERSION="$BIN/SEMINARTEXT_VERSION"

die() {
  echo "FAIL: $*" >&2
  exit 1
}

hash_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

activation_record() {
  local command="$1" operation="$2"
  shift 2
  "${SEMINARTEXT_INTEGRITY_PYTHON:-python3}" "$REPO/scripts/activation_receipt.py" "$command" \
    --root "$REPO" --deploy-dir "$BIN" --operation "$operation" "$@"
}

require_repo() {
  [[ "$(git -C "$REPO" rev-parse --is-inside-work-tree 2>/dev/null)" == "true" ]] || die "Git repository не найден: $REPO"

  local actual
  actual="$(cd "$REPO" && git rev-parse --show-toplevel)"
  [[ "$actual" == "$REPO" ]] \
    || die "неверный Git source of truth: $actual"
}

validate_roadmap_file() {
  local file="$1"

  [[ -f "$file" ]] || die "Roadmap не найден: $file"

  local roadmap_size
  roadmap_size="$(wc -c < "$file" | tr -d ' ')"

  (( roadmap_size > 10000 )) \
    || die "Roadmap подозрительно мал: $roadmap_size bytes"

  local required_markers=(
    "# 0. Operating Model / Human Gates"
    "# 2. Track A — Semantic Automation / Boundary Detection"
    "## 2.5 Dataset B — historical frozen validation"
    "## 2.6 Dataset C — blind validation milestone"
    "# 5. Document Pipeline"
    "## 5.x Source Registry / External Sources"
    "# 10. Knowledge Base / Obsidian Integration"
    "## 10.x Source Cards"
    "# CURRENT NEXT ACTION"
    "SEMINARTEXT_4_MVP_DEFINITION.md"
  )

  local marker
  for marker in "${required_markers[@]}"; do
    grep -Fq "$marker" "$file" \
      || die "Roadmap: отсутствует '$marker'"
  done
}

cmd_status() {
  require_repo
  cd "$REPO"

  echo "SEMINARTEXT DEV STATUS"
  echo "========================================"
  echo

  echo "SOURCE OF TRUTH"
  echo "  $REPO"
  echo

  echo "GIT"
  echo "  Branch: $(git branch --show-current)"
  echo "  Commit: $(git rev-parse --short HEAD)"
  echo "  Date:   $(git log -1 --format='%ci')"
  echo

  echo "WORKING TREE"
  if [[ -z "$(git status --short)" ]]; then
    echo "  clean"
  else
    git status --short | sed 's/^/  /'
  fi

  echo
  echo "MASTER FILES"
  ls -lh "$CODE" "$ROADMAP" "$STATE" "$TOPICS" "$TRANSLATE" "$EVIDENCE_FOUNDATION" "$PROJECT_KNOWLEDGE_BRIDGE" "$HUMAN_REVIEW_WORKFLOW" "$OWNED_TMP" "$GROUP_SOURCES" "$ASR_COMPLETION" "$CANONICAL_VALIDATOR" "$CANONICAL_SCHEMA" "$CANONICAL_KNOWLEDGE_VALIDATOR" "$CANONICAL_KNOWLEDGE_SCHEMA" "$CANONICAL_KNOWLEDGE_LIFECYCLE" "$PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$TOPIC_REVIEW_WORKFLOW_SCHEMA" "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$DATASET_GOVERNANCE" "$DATASET_REGISTRY" "$TOPIC_ENGINE_GOVERNANCE" "$TOPIC_ENGINE_LIFECYCLE" "$TOPIC_ENGINE_FREEZE" "$VERSION_FILE" | sed 's/^/  /'

  echo
  echo "MASTER HASHES"
  shasum -a 256 "$CODE" "$ROADMAP" "$STATE" "$TOPICS" "$TRANSLATE" "$EVIDENCE_FOUNDATION" "$PROJECT_KNOWLEDGE_BRIDGE" "$HUMAN_REVIEW_WORKFLOW" "$OWNED_TMP" "$GROUP_SOURCES" "$ASR_COMPLETION" "$CANONICAL_VALIDATOR" "$CANONICAL_SCHEMA" "$CANONICAL_KNOWLEDGE_VALIDATOR" "$CANONICAL_KNOWLEDGE_SCHEMA" "$CANONICAL_KNOWLEDGE_LIFECYCLE" "$PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$TOPIC_REVIEW_WORKFLOW_SCHEMA" "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$DATASET_GOVERNANCE" "$DATASET_REGISTRY" "$TOPIC_ENGINE_GOVERNANCE" "$TOPIC_ENGINE_LIFECYCLE" "$TOPIC_ENGINE_FREEZE" "$VERSION_FILE" | sed 's/^/  /'

  echo
  echo "DEPLOYED HASHES"
  for f in "$DEPLOY_CODE" "$DEPLOY_ROADMAP" "$DEPLOY_STATE" "$DEPLOY_TOPICS" "$DEPLOY_TRANSLATE" "$DEPLOY_EVIDENCE_FOUNDATION" "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" "$DEPLOY_HUMAN_REVIEW_WORKFLOW" "$DEPLOY_OWNED_TMP" "$DEPLOY_GROUP_SOURCES" "$DEPLOY_ASR_COMPLETION" "$DEPLOY_CANONICAL_VALIDATOR" "$DEPLOY_CANONICAL_SCHEMA" "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$DEPLOY_DATASET_GOVERNANCE" "$DEPLOY_DATASET_REGISTRY" "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" "$DEPLOY_TOPIC_ENGINE_FREEZE" "$DEPLOY_VERSION"; do
    if [[ -f "$f" ]]; then
      shasum -a 256 "$f" | sed 's/^/  /'
    else
      echo "  MISSING: $f"
    fi
  done

  echo
  echo "SYNC"
  local mismatches=0

  if [[ -f "$DEPLOY_CODE" ]] \
     && [[ "$(hash_file "$CODE")" == "$(hash_file "$DEPLOY_CODE")" ]]; then
    echo "  Code:    SYNC"
  else
    echo "  Code:    DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_ROADMAP" ]] \
     && [[ "$(hash_file "$ROADMAP")" == "$(hash_file "$DEPLOY_ROADMAP")" ]]; then
    echo "  Roadmap: SYNC"
  else
    echo "  Roadmap: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_STATE" ]] \
     && [[ "$(hash_file "$STATE")" == "$(hash_file "$DEPLOY_STATE")" ]]; then
    echo "  State:   SYNC"
  else
    echo "  State:   DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_TOPICS" ]] \
     && [[ "$(hash_file "$TOPICS")" == "$(hash_file "$DEPLOY_TOPICS")" ]]; then
    echo "  Topics:  SYNC"
  else
    echo "  Topics:  DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_TRANSLATE" ]] \
     && [[ "$(hash_file "$TRANSLATE")" == "$(hash_file "$DEPLOY_TRANSLATE")" ]]; then
    echo "  Translate: SYNC"
  else
    echo "  Translate: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_EVIDENCE_FOUNDATION" ]] \
     && [[ "$(hash_file "$EVIDENCE_FOUNDATION")" == "$(hash_file "$DEPLOY_EVIDENCE_FOUNDATION")" ]]; then
    echo "  Evidence Foundation: SYNC"
  else
    echo "  Evidence Foundation: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" ]] \
     && [[ "$(hash_file "$PROJECT_KNOWLEDGE_BRIDGE")" == "$(hash_file "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE")" ]]; then
    echo "  Project Knowledge bridge: SYNC"
  else
    echo "  Project Knowledge bridge: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_HUMAN_REVIEW_WORKFLOW" ]] \
     && [[ "$(hash_file "$HUMAN_REVIEW_WORKFLOW")" == "$(hash_file "$DEPLOY_HUMAN_REVIEW_WORKFLOW")" ]]; then
    echo "  Human Review workflow: SYNC"
  else
    echo "  Human Review workflow: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_OWNED_TMP" ]] \
     && [[ "$(hash_file "$OWNED_TMP")" == "$(hash_file "$DEPLOY_OWNED_TMP")" ]]; then
    echo "  Owned TMP: SYNC"
  else
    echo "  Owned TMP: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_GROUP_SOURCES" ]] \
     && [[ "$(hash_file "$GROUP_SOURCES")" == "$(hash_file "$DEPLOY_GROUP_SOURCES")" ]]; then
    echo "  Group sources: SYNC"
  else
    echo "  Group sources: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_ASR_COMPLETION" ]] \
     && [[ "$(hash_file "$ASR_COMPLETION")" == "$(hash_file "$DEPLOY_ASR_COMPLETION")" ]]; then
    echo "  ASR completion identity: SYNC"
  else
    echo "  ASR completion identity: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_CANONICAL_VALIDATOR" ]] \
     && [[ "$(hash_file "$CANONICAL_VALIDATOR")" == "$(hash_file "$DEPLOY_CANONICAL_VALIDATOR")" ]]; then
    echo "  Canonical validator: SYNC"
  else
    echo "  Canonical validator: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_CANONICAL_SCHEMA" ]] \
     && [[ "$(hash_file "$CANONICAL_SCHEMA")" == "$(hash_file "$DEPLOY_CANONICAL_SCHEMA")" ]]; then
    echo "  Canonical schema: SYNC"
  else
    echo "  Canonical schema: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  for spec in \
    "Canonical Knowledge validator|$CANONICAL_KNOWLEDGE_VALIDATOR|$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" \
    "Canonical Knowledge schema|$CANONICAL_KNOWLEDGE_SCHEMA|$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" \
    "Canonical Knowledge lifecycle|$CANONICAL_KNOWLEDGE_LIFECYCLE|$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" \
    "Project Knowledge input schema|$PROJECT_KNOWLEDGE_INPUT_SCHEMA|$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" \
    "Topic Review workflow schema|$TOPIC_REVIEW_WORKFLOW_SCHEMA|$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" \
    "Topic Review workflow V2 schema|$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2|$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2"; do
    IFS='|' read -r label source deployed <<< "$spec"
    if [[ -f "$deployed" ]] && [[ "$(hash_file "$source")" == "$(hash_file "$deployed")" ]]; then
      echo "  $label: SYNC"
    else
      echo "  $label: DIFFERENT"
      mismatches=$((mismatches + 1))
    fi
  done

  if [[ -f "$DEPLOY_DATASET_GOVERNANCE" ]] \
     && [[ "$(hash_file "$DATASET_GOVERNANCE")" == "$(hash_file "$DEPLOY_DATASET_GOVERNANCE")" ]]; then
    echo "  Dataset governance: SYNC"
  else
    echo "  Dataset governance: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  if [[ -f "$DEPLOY_DATASET_REGISTRY" ]] \
     && [[ "$(hash_file "$DATASET_REGISTRY")" == "$(hash_file "$DEPLOY_DATASET_REGISTRY")" ]]; then
    echo "  Dataset Registry: SYNC"
  else
    echo "  Dataset Registry: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  for spec in \
    "Topic Engine governance|$TOPIC_ENGINE_GOVERNANCE|$DEPLOY_TOPIC_ENGINE_GOVERNANCE" \
    "Topic Engine lifecycle|$TOPIC_ENGINE_LIFECYCLE|$DEPLOY_TOPIC_ENGINE_LIFECYCLE" \
    "Topic Engine freeze|$TOPIC_ENGINE_FREEZE|$DEPLOY_TOPIC_ENGINE_FREEZE"; do
    IFS='|' read -r label source deployed <<< "$spec"
    if [[ -f "$deployed" ]] && [[ "$(hash_file "$source")" == "$(hash_file "$deployed")" ]]; then
      echo "  $label: SYNC"
    else
      echo "  $label: DIFFERENT"
      mismatches=$((mismatches + 1))
    fi
  done

  if [[ -f "$DEPLOY_VERSION" ]] \
     && [[ "$(hash_file "$VERSION_FILE")" == "$(hash_file "$DEPLOY_VERSION")" ]]; then
    echo "  Version: SYNC"
  else
    echo "  Version: DIFFERENT"
    mismatches=$((mismatches + 1))
  fi

  echo
  if (( mismatches == 0 )); then
    echo "DEPLOY STATUS: SYNC"
  else
    echo "DEPLOY STATUS: DIFFERENT ($mismatches/25)"
  fi
}

cmd_check() {
  require_repo
  cd "$REPO"

  echo "SEMINARTEXT DEV CHECK"
  echo "========================================"

  [[ -f "$CODE" ]] || die "нет master code"
  [[ -f "$ROADMAP" ]] || die "нет master Roadmap"
  [[ -f "$STATE" ]] || die "нет master State"
  [[ -f "$TOPICS" ]] || die "нет master Topic Engine module"
  [[ -f "$TRANSLATE" ]] || die "нет master Translate module"
  [[ -f "$EVIDENCE_FOUNDATION" ]] || die "нет master Evidence Foundation module"
  [[ -f "$PROJECT_KNOWLEDGE_BRIDGE" ]] || die "нет master Project Knowledge bridge module"
  [[ -f "$HUMAN_REVIEW_WORKFLOW" ]] || die "нет master Human Review workflow module"
  [[ -f "$OWNED_TMP" ]] || die "missing owned TMP lifecycle module"
  [[ -f "$GROUP_SOURCES" ]] || die "missing group sources module"
  [[ -f "$ASR_COMPLETION" ]] || die "missing ASR completion identity module"
  [[ -f "$CANONICAL_VALIDATOR" ]] || die "нет master Canonical validator"
  [[ -f "$CANONICAL_SCHEMA" ]] || die "нет master Canonical schema"
  [[ -f "$CANONICAL_KNOWLEDGE_VALIDATOR" ]] || die "нет master Canonical Knowledge validator"
  [[ -f "$CANONICAL_KNOWLEDGE_SCHEMA" ]] || die "нет master Canonical Knowledge schema"
  [[ -f "$CANONICAL_KNOWLEDGE_LIFECYCLE" ]] || die "нет master Canonical Knowledge lifecycle"
  [[ -f "$PROJECT_KNOWLEDGE_INPUT_SCHEMA" ]] || die "нет master Project Knowledge input schema"
  [[ -f "$TOPIC_REVIEW_WORKFLOW_SCHEMA" ]] || die "нет master Topic Review workflow schema"
  [[ -f "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" ]] || die "нет master Topic Review workflow V2 schema"
  [[ -f "$DATASET_GOVERNANCE" ]] || die "нет master Dataset Governance module"
  [[ -f "$DATASET_REGISTRY" ]] || die "нет master Dataset Registry"
  [[ -f "$TOPIC_ENGINE_GOVERNANCE" ]] || die "нет master Topic Engine Governance module"
  [[ -f "$TOPIC_ENGINE_LIFECYCLE" ]] || die "нет master Topic Engine Lifecycle"
  [[ -f "$TOPIC_ENGINE_FREEZE" ]] || die "нет master Topic Engine Freeze record"
  [[ -f "$VERSION_FILE" ]] || die "нет authoritative version-файла"
  [[ -f "$GOVERNANCE_CHECK" ]] || die "нет governance consistency checker"

  bash -n "$CODE" || die "ошибка Bash syntax"
  echo "[OK] Bash syntax"

  python3 -m json.tool "$STATE" >/dev/null \
    || die "SEMINARTEXT_4_STATE.json invalid"
  echo "[OK] State JSON"

  python3 - "$TOPICS" "$TRANSLATE" "$EVIDENCE_FOUNDATION" "$PROJECT_KNOWLEDGE_BRIDGE" "$HUMAN_REVIEW_WORKFLOW" "$OWNED_TMP" "$GROUP_SOURCES" "$ASR_COMPLETION" "$CANONICAL_VALIDATOR" "$CANONICAL_KNOWLEDGE_VALIDATOR" "$DATASET_GOVERNANCE" "$TOPIC_ENGINE_GOVERNANCE" <<'PYMODULES' \
    || die "ошибка Python syntax в runtime-модулях"
import ast
import sys
from pathlib import Path

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
PYMODULES
  echo "[OK] Runtime module syntax"

  python3 -m json.tool "$CANONICAL_SCHEMA" >/dev/null \
    || die "Canonical Evidence schema invalid"
  echo "[OK] Canonical Evidence schema"

  python3 -m json.tool "$CANONICAL_KNOWLEDGE_SCHEMA" >/dev/null \
    || die "Canonical Knowledge schema invalid"
  python3 -m json.tool "$CANONICAL_KNOWLEDGE_LIFECYCLE" >/dev/null \
    || die "Canonical Knowledge lifecycle invalid"
  python3 -m json.tool "$PROJECT_KNOWLEDGE_INPUT_SCHEMA" >/dev/null \
    || die "Project Knowledge input schema invalid"
  python3 -m json.tool "$TOPIC_REVIEW_WORKFLOW_SCHEMA" >/dev/null \
    || die "Topic Review workflow schema invalid"
  python3 -m json.tool "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" >/dev/null \
    || die "Topic Review workflow V2 schema invalid"
  echo "[OK] Project Knowledge contracts"

  python3 -m json.tool "$DATASET_REGISTRY" >/dev/null \
    || die "Dataset Registry invalid"
  python3 "$DATASET_GOVERNANCE" validate --registry "$DATASET_REGISTRY" >/dev/null \
    || die "Dataset Registry policy validation failed"
  echo "[OK] Dataset Registry"

  python3 -m json.tool "$TOPIC_ENGINE_LIFECYCLE" >/dev/null \
    || die "Topic Engine Lifecycle invalid"
  python3 -m json.tool "$TOPIC_ENGINE_FREEZE" >/dev/null \
    || die "Topic Engine Freeze invalid"
  python3 "$TOPIC_ENGINE_GOVERNANCE" validate --lifecycle "$TOPIC_ENGINE_LIFECYCLE" >/dev/null \
    || die "Topic Engine Lifecycle validation failed"
  echo "[OK] Topic Engine freeze governance"

  validate_roadmap_file "$ROADMAP"
  echo "[OK] Roadmap structure"

  python3 "$GOVERNANCE_CHECK" --root "$REPO" \
    || die "governance consistency FAIL"
  echo "[OK] Governance consistency"

  echo
  echo "CHECK: PASS"
}

cmd_checkpoint() {
  require_repo
  cd "$REPO"

  local message="${1:-}"
  shift || true

  [[ -n "$message" ]] || {
    echo "Использование:"
    echo '  scripts/seminartext-dev checkpoint "commit message" FILE [FILE ...]'
    return 2
  }

  (($# > 0)) || die "checkpoint: не указаны файлы"

  cmd_check
  echo

  local file
  for file in "$@"; do
    git ls-files --error-unmatch -- "$file" >/dev/null 2>&1 \
      || die "checkpoint разрешён только для уже tracked-файлов: $file"
  done

  git add -- "$@"

  if git diff --cached --quiet; then
    die "checkpoint: нет изменений для commit"
  fi

  echo "STAGED:"
  git diff --cached --name-status
  echo

  git commit -m "$message"

  echo
  echo "CHECKPOINT: OK"
  echo "Commit: $(git rev-parse --short HEAD)"
}

cmd_deploy() {
  require_repo
  cd "$REPO"

  cmd_check

  # Незакоммиченные изменения tracked-файлов запрещают deploy.
  # Неотслеживаемые файлы сами по себе deploy не блокируют.
  if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
    echo
    git status --short --untracked-files=no
    die "deploy запрещён: есть незакоммиченные tracked-изменения"
  fi

  local stamp commit backup
  stamp="$(date '+%Y%m%d_%H%M%S')"
  commit="$(git rev-parse --short HEAD)"
  backup="$BACKUP_ROOT/${stamp}__${commit}"

  mkdir -p "$backup" "$BIN"

  echo
  echo "DEPLOY"
  echo "========================================"
  echo "Source: $REPO"
  echo "Commit: $commit"
  echo "Backup: $backup"
  echo

  # Сохраняем точное текущее deployed-состояние.
  [[ -f "$DEPLOY_CODE" ]] \
    && cp -p "$DEPLOY_CODE" "$backup/seminartext_4.0_work"
  [[ -f "$DEPLOY_ROADMAP" ]] \
    && cp -p "$DEPLOY_ROADMAP" "$backup/SEMINARTEXT_4_ROADMAP.md"
  [[ -f "$DEPLOY_STATE" ]] \
    && cp -p "$DEPLOY_STATE" "$backup/SEMINARTEXT_4_STATE.json"
  [[ -f "$DEPLOY_TOPICS" ]] \
    && cp -p "$DEPLOY_TOPICS" "$backup/seminartext_topics.py"
  [[ -f "$DEPLOY_TRANSLATE" ]] \
    && cp -p "$DEPLOY_TRANSLATE" "$backup/seminartext_translate.py"
  [[ -f "$DEPLOY_EVIDENCE_FOUNDATION" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_EVIDENCE_FOUNDATION" "$backup/seminartext_modules/evidence_foundation.py"; }
  [[ -f "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" "$backup/seminartext_modules/project_knowledge_bridge.py"; }
  [[ -f "$DEPLOY_HUMAN_REVIEW_WORKFLOW" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_HUMAN_REVIEW_WORKFLOW" "$backup/seminartext_modules/human_review_workflow.py"; }
  [[ -f "$DEPLOY_OWNED_TMP" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_OWNED_TMP" "$backup/seminartext_modules/owned_tmp.py"; }
  [[ -f "$DEPLOY_GROUP_SOURCES" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_GROUP_SOURCES" "$backup/seminartext_modules/group_sources.py"; }
  [[ -f "$DEPLOY_ASR_COMPLETION" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_ASR_COMPLETION" "$backup/seminartext_modules/asr_completion.py"; }
  [[ -f "$DEPLOY_ASR_COMPLETION" ]] || : > "$backup/ASR_COMPLETION_ABSENT"
  [[ -f "$DEPLOY_CANONICAL_VALIDATOR" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_CANONICAL_VALIDATOR" "$backup/schemas/validate_canonical_evidence_v1.py"; }
  [[ -f "$DEPLOY_CANONICAL_SCHEMA" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_CANONICAL_SCHEMA" "$backup/schemas/canonical_evidence_v1.schema.json"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" "$backup/schemas/validate_canonical_knowledge_v1.py"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" "$backup/schemas/canonical_knowledge_v1.schema.json"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" "$backup/schemas/canonical_knowledge_lifecycle_v1.json"; }
  [[ -f "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$backup/schemas/project_knowledge_input_v1.schema.json"; }
  [[ -f "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" "$backup/schemas/topic_review_workflow_v1.schema.json"; }
  [[ -f "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" ]] \
    && { mkdir -p "$backup/schemas"; cp -p "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$backup/schemas/topic_review_workflow_v2.schema.json"; }
  [[ -f "$DEPLOY_DATASET_GOVERNANCE" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_DATASET_GOVERNANCE" "$backup/seminartext_modules/dataset_governance.py"; }
  [[ -f "$DEPLOY_DATASET_REGISTRY" ]] \
    && { mkdir -p "$backup/governance"; cp -p "$DEPLOY_DATASET_REGISTRY" "$backup/governance/dataset_registry.json"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" ]] \
    && { mkdir -p "$backup/seminartext_modules"; cp -p "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" "$backup/seminartext_modules/topic_engine_governance.py"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" ]] \
    && { mkdir -p "$backup/governance"; cp -p "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" "$backup/governance/topic_engine_lifecycle.json"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_FREEZE" ]] \
    && { mkdir -p "$backup/governance"; cp -p "$DEPLOY_TOPIC_ENGINE_FREEZE" "$backup/governance/topic_engine_freeze.json"; }
  [[ -f "$DEPLOY_VERSION" ]] \
    && cp -p "$DEPLOY_VERSION" "$backup/SEMINARTEXT_VERSION"

  cat > "$backup/manifest.txt" <<MANIFEST
created=$stamp
source_repo=$REPO
source_commit=$commit
source_branch=$(git branch --show-current)
MANIFEST

  # Capture native mutation identity and a bounded central predecessor snapshot
  # before replacing files. Registry availability is not required for deployment.
  activation_record begin "$backup" >/dev/null

  local tmp_code tmp_roadmap tmp_state tmp_topics tmp_translate tmp_evidence_foundation tmp_project_knowledge_bridge tmp_human_review_workflow tmp_owned_tmp tmp_group_sources tmp_asr_completion tmp_canonical_validator tmp_canonical_schema tmp_canonical_knowledge_validator tmp_canonical_knowledge_schema tmp_canonical_knowledge_lifecycle tmp_project_knowledge_input_schema tmp_topic_review_workflow_schema tmp_topic_review_workflow_schema_v2 tmp_dataset_governance tmp_dataset_registry tmp_topic_engine_governance tmp_topic_engine_lifecycle tmp_topic_engine_freeze tmp_version
  tmp_code="$DEPLOY_CODE.new.$$"
  tmp_roadmap="$DEPLOY_ROADMAP.new.$$"
  tmp_state="$DEPLOY_STATE.new.$$"
  tmp_topics="$DEPLOY_TOPICS.new.$$"
  tmp_translate="$DEPLOY_TRANSLATE.new.$$"
  tmp_evidence_foundation="$DEPLOY_EVIDENCE_FOUNDATION.new.$$"
  tmp_project_knowledge_bridge="$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE.new.$$"
  tmp_human_review_workflow="$DEPLOY_HUMAN_REVIEW_WORKFLOW.new.$$"
  tmp_owned_tmp="$DEPLOY_OWNED_TMP.new.$$"
  tmp_group_sources="$DEPLOY_GROUP_SOURCES.new.$$"
  tmp_asr_completion="$DEPLOY_ASR_COMPLETION.new.$$"
  tmp_canonical_validator="$DEPLOY_CANONICAL_VALIDATOR.new.$$"
  tmp_canonical_schema="$DEPLOY_CANONICAL_SCHEMA.new.$$"
  tmp_canonical_knowledge_validator="$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR.new.$$"
  tmp_canonical_knowledge_schema="$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA.new.$$"
  tmp_canonical_knowledge_lifecycle="$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE.new.$$"
  tmp_project_knowledge_input_schema="$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA.new.$$"
  tmp_topic_review_workflow_schema="$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA.new.$$"
  tmp_topic_review_workflow_schema_v2="$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2.new.$$"
  tmp_dataset_governance="$DEPLOY_DATASET_GOVERNANCE.new.$$"
  tmp_dataset_registry="$DEPLOY_DATASET_REGISTRY.new.$$"
  tmp_topic_engine_governance="$DEPLOY_TOPIC_ENGINE_GOVERNANCE.new.$$"
  tmp_topic_engine_lifecycle="$DEPLOY_TOPIC_ENGINE_LIFECYCLE.new.$$"
  tmp_topic_engine_freeze="$DEPLOY_TOPIC_ENGINE_FREEZE.new.$$"
  tmp_version="$DEPLOY_VERSION.new.$$"

  cleanup_deploy_tmp() {
    rm -f "$tmp_code" "$tmp_roadmap" "$tmp_state" "$tmp_topics" "$tmp_translate" "$tmp_evidence_foundation" "$tmp_project_knowledge_bridge" "$tmp_human_review_workflow" "$tmp_owned_tmp" "$tmp_group_sources" "$tmp_asr_completion" "$tmp_canonical_validator" "$tmp_canonical_schema" "$tmp_canonical_knowledge_validator" "$tmp_canonical_knowledge_schema" "$tmp_canonical_knowledge_lifecycle" "$tmp_project_knowledge_input_schema" "$tmp_topic_review_workflow_schema" "$tmp_topic_review_workflow_schema_v2" "$tmp_dataset_governance" "$tmp_dataset_registry" "$tmp_topic_engine_governance" "$tmp_topic_engine_lifecycle" "$tmp_topic_engine_freeze" "$tmp_version"
  }
  trap cleanup_deploy_tmp RETURN INT TERM

  cp -p "$CODE" "$tmp_code"
  cp -p "$ROADMAP" "$tmp_roadmap"
  cp -p "$STATE" "$tmp_state"
  cp -p "$TOPICS" "$tmp_topics"
  cp -p "$TRANSLATE" "$tmp_translate"
  mkdir -p "$(dirname "$tmp_evidence_foundation")" "$(dirname "$tmp_canonical_validator")" "$(dirname "$tmp_dataset_registry")"
  cp -p "$EVIDENCE_FOUNDATION" "$tmp_evidence_foundation"
  cp -p "$PROJECT_KNOWLEDGE_BRIDGE" "$tmp_project_knowledge_bridge"
  cp -p "$HUMAN_REVIEW_WORKFLOW" "$tmp_human_review_workflow"
  cp -p "$OWNED_TMP" "$tmp_owned_tmp"
  cp -p "$GROUP_SOURCES" "$tmp_group_sources"
  cp -p "$ASR_COMPLETION" "$tmp_asr_completion"
  cp -p "$CANONICAL_VALIDATOR" "$tmp_canonical_validator"
  cp -p "$CANONICAL_SCHEMA" "$tmp_canonical_schema"
  cp -p "$CANONICAL_KNOWLEDGE_VALIDATOR" "$tmp_canonical_knowledge_validator"
  cp -p "$CANONICAL_KNOWLEDGE_SCHEMA" "$tmp_canonical_knowledge_schema"
  cp -p "$CANONICAL_KNOWLEDGE_LIFECYCLE" "$tmp_canonical_knowledge_lifecycle"
  cp -p "$PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$tmp_project_knowledge_input_schema"
  cp -p "$TOPIC_REVIEW_WORKFLOW_SCHEMA" "$tmp_topic_review_workflow_schema"
  cp -p "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$tmp_topic_review_workflow_schema_v2"
  cp -p "$DATASET_GOVERNANCE" "$tmp_dataset_governance"
  cp -p "$DATASET_REGISTRY" "$tmp_dataset_registry"
  cp -p "$TOPIC_ENGINE_GOVERNANCE" "$tmp_topic_engine_governance"
  cp -p "$TOPIC_ENGINE_LIFECYCLE" "$tmp_topic_engine_lifecycle"
  cp -p "$TOPIC_ENGINE_FREEZE" "$tmp_topic_engine_freeze"
  cp -p "$VERSION_FILE" "$tmp_version"

  # Проверяем именно будущие deployed-файлы ДО замены.
  bash -n "$tmp_code" \
    || die "deploy temp code: Bash syntax FAIL"

  python3 -m json.tool "$tmp_state" >/dev/null \
    || die "deploy temp State JSON invalid"

  validate_roadmap_file "$tmp_roadmap"

  python3 - "$tmp_topics" "$tmp_translate" "$tmp_evidence_foundation" "$tmp_project_knowledge_bridge" "$tmp_human_review_workflow" "$tmp_owned_tmp" "$tmp_group_sources" "$tmp_canonical_validator" "$tmp_canonical_knowledge_validator" "$tmp_dataset_governance" "$tmp_topic_engine_governance" <<'PYMODULES' \
    || die "deploy temp runtime module syntax invalid"
import ast
import sys
from pathlib import Path

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
PYMODULES

  python3 -m json.tool "$tmp_dataset_registry" >/dev/null \
    || die "deploy temp Dataset Registry invalid"
  python3 -m json.tool "$tmp_canonical_knowledge_schema" >/dev/null \
    || die "deploy temp Canonical Knowledge schema invalid"
  python3 -m json.tool "$tmp_canonical_knowledge_lifecycle" >/dev/null \
    || die "deploy temp Canonical Knowledge lifecycle invalid"
  python3 -m json.tool "$tmp_project_knowledge_input_schema" >/dev/null \
    || die "deploy temp Project Knowledge input schema invalid"
  python3 -m json.tool "$tmp_topic_review_workflow_schema" >/dev/null \
    || die "deploy temp Topic Review workflow schema invalid"
  python3 -m json.tool "$tmp_topic_review_workflow_schema_v2" >/dev/null \
    || die "deploy temp Topic Review workflow V2 schema invalid"
  python3 -m json.tool "$tmp_topic_engine_lifecycle" >/dev/null \
    || die "deploy temp Topic Engine Lifecycle invalid"
  python3 -m json.tool "$tmp_topic_engine_freeze" >/dev/null \
    || die "deploy temp Topic Engine Freeze invalid"

  chmod +x "$tmp_code" "$tmp_topics" "$tmp_translate"

  # Atomic replace на том же filesystem.
  mv "$tmp_code" "$DEPLOY_CODE"
  mv "$tmp_roadmap" "$DEPLOY_ROADMAP"
  mv "$tmp_state" "$DEPLOY_STATE"
  mv "$tmp_topics" "$DEPLOY_TOPICS"
  mv "$tmp_translate" "$DEPLOY_TRANSLATE"
  mkdir -p "$(dirname "$DEPLOY_EVIDENCE_FOUNDATION")" "$(dirname "$DEPLOY_CANONICAL_VALIDATOR")" "$(dirname "$DEPLOY_DATASET_REGISTRY")" "$(dirname "$DEPLOY_TOPIC_ENGINE_GOVERNANCE")"
  mv "$tmp_evidence_foundation" "$DEPLOY_EVIDENCE_FOUNDATION"
  mv "$tmp_project_knowledge_bridge" "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE"
  mv "$tmp_human_review_workflow" "$DEPLOY_HUMAN_REVIEW_WORKFLOW"
  mv "$tmp_owned_tmp" "$DEPLOY_OWNED_TMP"
  mv "$tmp_group_sources" "$DEPLOY_GROUP_SOURCES"
  mv "$tmp_asr_completion" "$DEPLOY_ASR_COMPLETION"
  mv "$tmp_canonical_validator" "$DEPLOY_CANONICAL_VALIDATOR"
  mv "$tmp_canonical_schema" "$DEPLOY_CANONICAL_SCHEMA"
  mv "$tmp_canonical_knowledge_validator" "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR"
  mv "$tmp_canonical_knowledge_schema" "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA"
  mv "$tmp_canonical_knowledge_lifecycle" "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE"
  mv "$tmp_project_knowledge_input_schema" "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA"
  mv "$tmp_topic_review_workflow_schema" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA"
  mv "$tmp_topic_review_workflow_schema_v2" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2"
  mv "$tmp_dataset_governance" "$DEPLOY_DATASET_GOVERNANCE"
  mv "$tmp_dataset_registry" "$DEPLOY_DATASET_REGISTRY"
  mv "$tmp_topic_engine_governance" "$DEPLOY_TOPIC_ENGINE_GOVERNANCE"
  mv "$tmp_topic_engine_lifecycle" "$DEPLOY_TOPIC_ENGINE_LIFECYCLE"
  mv "$tmp_topic_engine_freeze" "$DEPLOY_TOPIC_ENGINE_FREEZE"
  mv "$tmp_version" "$DEPLOY_VERSION"

  # Финальная проверка hashes.
  [[ "$(hash_file "$CODE")" == "$(hash_file "$DEPLOY_CODE")" ]] \
    || die "deploy hash mismatch: code"

  [[ "$(hash_file "$ROADMAP")" == "$(hash_file "$DEPLOY_ROADMAP")" ]] \
    || die "deploy hash mismatch: Roadmap"

  [[ "$(hash_file "$STATE")" == "$(hash_file "$DEPLOY_STATE")" ]] \
    || die "deploy hash mismatch: State"

  [[ "$(hash_file "$TOPICS")" == "$(hash_file "$DEPLOY_TOPICS")" ]] \
    || die "deploy hash mismatch: Topic Engine"

  [[ "$(hash_file "$TRANSLATE")" == "$(hash_file "$DEPLOY_TRANSLATE")" ]] \
    || die "deploy hash mismatch: Translate"

  [[ "$(hash_file "$EVIDENCE_FOUNDATION")" == "$(hash_file "$DEPLOY_EVIDENCE_FOUNDATION")" ]] \
    || die "deploy hash mismatch: Evidence Foundation"

  [[ "$(hash_file "$PROJECT_KNOWLEDGE_BRIDGE")" == "$(hash_file "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE")" ]] \
    || die "deploy hash mismatch: Project Knowledge bridge"
  [[ "$(hash_file "$HUMAN_REVIEW_WORKFLOW")" == "$(hash_file "$DEPLOY_HUMAN_REVIEW_WORKFLOW")" ]] \
    || die "deploy hash mismatch: Human Review workflow"
  [[ "$(hash_file "$OWNED_TMP")" == "$(hash_file "$DEPLOY_OWNED_TMP")" ]] \
    || die "deploy hash mismatch: owned TMP lifecycle"
  [[ "$(hash_file "$GROUP_SOURCES")" == "$(hash_file "$DEPLOY_GROUP_SOURCES")" ]] \
    || die "deploy hash mismatch: group sources"

  [[ "$(hash_file "$CANONICAL_VALIDATOR")" == "$(hash_file "$DEPLOY_CANONICAL_VALIDATOR")" ]] \
    || die "deploy hash mismatch: Canonical validator"

  [[ "$(hash_file "$CANONICAL_SCHEMA")" == "$(hash_file "$DEPLOY_CANONICAL_SCHEMA")" ]] \
    || die "deploy hash mismatch: Canonical schema"

  [[ "$(hash_file "$CANONICAL_KNOWLEDGE_VALIDATOR")" == "$(hash_file "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR")" ]] \
    || die "deploy hash mismatch: Canonical Knowledge validator"
  [[ "$(hash_file "$CANONICAL_KNOWLEDGE_SCHEMA")" == "$(hash_file "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA")" ]] \
    || die "deploy hash mismatch: Canonical Knowledge schema"
  [[ "$(hash_file "$CANONICAL_KNOWLEDGE_LIFECYCLE")" == "$(hash_file "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE")" ]] \
    || die "deploy hash mismatch: Canonical Knowledge lifecycle"
  [[ "$(hash_file "$PROJECT_KNOWLEDGE_INPUT_SCHEMA")" == "$(hash_file "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA")" ]] \
    || die "deploy hash mismatch: Project Knowledge input schema"
  [[ "$(hash_file "$TOPIC_REVIEW_WORKFLOW_SCHEMA")" == "$(hash_file "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA")" ]] \
    || die "deploy hash mismatch: Topic Review workflow schema"
  [[ "$(hash_file "$TOPIC_REVIEW_WORKFLOW_SCHEMA_V2")" == "$(hash_file "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2")" ]] \
    || die "deploy hash mismatch: Topic Review workflow V2 schema"

  [[ "$(hash_file "$DATASET_GOVERNANCE")" == "$(hash_file "$DEPLOY_DATASET_GOVERNANCE")" ]] \
    || die "deploy hash mismatch: Dataset Governance"

  [[ "$(hash_file "$DATASET_REGISTRY")" == "$(hash_file "$DEPLOY_DATASET_REGISTRY")" ]] \
    || die "deploy hash mismatch: Dataset Registry"

  [[ "$(hash_file "$TOPIC_ENGINE_GOVERNANCE")" == "$(hash_file "$DEPLOY_TOPIC_ENGINE_GOVERNANCE")" ]] \
    || die "deploy hash mismatch: Topic Engine Governance"
  [[ "$(hash_file "$TOPIC_ENGINE_LIFECYCLE")" == "$(hash_file "$DEPLOY_TOPIC_ENGINE_LIFECYCLE")" ]] \
    || die "deploy hash mismatch: Topic Engine Lifecycle"
  [[ "$(hash_file "$TOPIC_ENGINE_FREEZE")" == "$(hash_file "$DEPLOY_TOPIC_ENGINE_FREEZE")" ]] \
    || die "deploy hash mismatch: Topic Engine Freeze"

  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-evidence-check --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-evidence-check"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-obsidian-export --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-obsidian-export"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-review-prepare --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-review-prepare"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-review-v2-status --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-review-v2-status"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-review-boundary-prepare --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-review-boundary-prepare"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-review-boundary-resolve --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-review-boundary-resolve"
  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" project-review-boundary-status --help >/dev/null 2>&1 \
    || die "deployed functional smoke failed: project-review-boundary-status"

  PYTHONDONTWRITEBYTECODE=1 "$DEPLOY_CODE" dataset-policy-check A gold_read --json >/dev/null 2>&1 \
    || die "deployed functional smoke failed: dataset-policy-check"

  python3 "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" validate --lifecycle "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" --deployed --json >/dev/null 2>&1 \
    || die "deployed functional smoke failed: Topic Engine lifecycle provenance"
  python3 "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" freeze-check --freeze "$DEPLOY_TOPIC_ENGINE_FREEZE" --dataset-registry "$DEPLOY_DATASET_REGISTRY" --lifecycle "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" --deployed --json >/dev/null 2>&1 \
    || die "deployed functional smoke failed: Topic Engine freeze gate"

  [[ "$(hash_file "$VERSION_FILE")" == "$(hash_file "$DEPLOY_VERSION")" ]] \
    || die "deploy hash mismatch: Version"

  activation_record installed "$backup" >/dev/null
  LAST_DEPLOY_BACKUP="$backup"

  echo "[OK] Code deployed"
  echo "[OK] Roadmap deployed"
  echo "[OK] State deployed"
  echo "[OK] Topic Engine module deployed"
  echo "[OK] Translate module deployed"
  echo "[OK] Evidence Foundation module deployed"
  echo "[OK] Project Knowledge bridge deployed"
  echo "[OK] Human Review workflow deployed"
  echo "[OK] Canonical validator/schema deployed"
  echo "[OK] Canonical Knowledge contracts deployed"
  echo "[OK] Dataset Governance module/Registry deployed"
  echo "[OK] Topic Engine Governance module/Lifecycle/Freeze deployed"
  echo "[OK] Deployed functional smoke"
  echo "[OK] Version contract deployed"
  echo "[OK] SHA-256 verified"
  echo
  echo "DEPLOY: PASS"
  echo "Backup: $backup"
  echo "ACTIVATION: POST_CHECKS_REQUIRED (activation-complete $backup)"
}

cmd_rollback() {
  require_repo

  local requested="${1:-latest}"

  mkdir -p "$BACKUP_ROOT"

  if [[ "$requested" == "list" ]]; then
    echo "AVAILABLE DEPLOY BACKUPS"
    echo "========================================"
    find "$BACKUP_ROOT" \
      -mindepth 1 -maxdepth 1 -type d \
      -print | sort -r
    return 0
  fi

  local backup

  if [[ "$requested" == "latest" ]]; then
    backup="$(
      find "$BACKUP_ROOT" \
        -mindepth 1 -maxdepth 1 -type d \
        -print | sort -r | head -n 1
    )"
  else
    if [[ -d "$requested" ]]; then
      backup="$requested"
    elif [[ -d "$BACKUP_ROOT/$requested" ]]; then
      backup="$BACKUP_ROOT/$requested"
    else
      die "rollback backup не найден: $requested"
    fi
  fi

  [[ -n "${backup:-}" && -d "$backup" ]] \
    || die "нет доступных deploy-backups"

  local backup_code backup_roadmap backup_state backup_topics backup_translate backup_evidence_foundation backup_project_knowledge_bridge backup_human_review_workflow backup_owned_tmp backup_group_sources backup_asr_completion backup_canonical_validator backup_canonical_schema backup_canonical_knowledge_validator backup_canonical_knowledge_schema backup_canonical_knowledge_lifecycle backup_project_knowledge_input_schema backup_topic_review_workflow_schema backup_topic_review_workflow_schema_v2 backup_dataset_governance backup_dataset_registry backup_topic_engine_governance backup_topic_engine_lifecycle backup_topic_engine_freeze backup_version
  backup_code="$backup/seminartext_4.0_work"
  backup_roadmap="$backup/SEMINARTEXT_4_ROADMAP.md"
  backup_state="$backup/SEMINARTEXT_4_STATE.json"
  backup_topics="$backup/seminartext_topics.py"
  backup_translate="$backup/seminartext_translate.py"
  backup_evidence_foundation="$backup/seminartext_modules/evidence_foundation.py"
  backup_project_knowledge_bridge="$backup/seminartext_modules/project_knowledge_bridge.py"
  backup_human_review_workflow="$backup/seminartext_modules/human_review_workflow.py"
  backup_owned_tmp="$backup/seminartext_modules/owned_tmp.py"
  backup_group_sources="$backup/seminartext_modules/group_sources.py"
  backup_asr_completion="$backup/seminartext_modules/asr_completion.py"
  backup_canonical_validator="$backup/schemas/validate_canonical_evidence_v1.py"
  backup_canonical_schema="$backup/schemas/canonical_evidence_v1.schema.json"
  backup_canonical_knowledge_validator="$backup/schemas/validate_canonical_knowledge_v1.py"
  backup_canonical_knowledge_schema="$backup/schemas/canonical_knowledge_v1.schema.json"
  backup_canonical_knowledge_lifecycle="$backup/schemas/canonical_knowledge_lifecycle_v1.json"
  backup_project_knowledge_input_schema="$backup/schemas/project_knowledge_input_v1.schema.json"
  backup_topic_review_workflow_schema="$backup/schemas/topic_review_workflow_v1.schema.json"
  backup_topic_review_workflow_schema_v2="$backup/schemas/topic_review_workflow_v2.schema.json"
  backup_dataset_governance="$backup/seminartext_modules/dataset_governance.py"
  backup_dataset_registry="$backup/governance/dataset_registry.json"
  backup_topic_engine_governance="$backup/seminartext_modules/topic_engine_governance.py"
  backup_topic_engine_lifecycle="$backup/governance/topic_engine_lifecycle.json"
  backup_topic_engine_freeze="$backup/governance/topic_engine_freeze.json"
  backup_version="$backup/SEMINARTEXT_VERSION"

  [[ -f "$backup_code" ]] \
    || die "backup не содержит code: $backup"

  [[ -f "$backup_roadmap" ]] \
    || die "backup не содержит Roadmap: $backup"

  [[ -f "$backup_state" ]] \
    || die "backup не содержит State: $backup"

  bash -n "$backup_code" \
    || die "backup code syntax invalid"

  python3 -m json.tool "$backup_state" >/dev/null \
    || die "backup State JSON invalid"

  # Для rollback не требуем актуальные Roadmap markers:
  # старый backup может законно относиться к предыдущей schema.
  local rollback_guard
  rollback_guard="$BACKUP_ROOT/pre_rollback_$(date '+%Y%m%d_%H%M%S')"
  mkdir -p "$rollback_guard"

  # Invalidate pending publications even when rollback restores identical bytes.
  activation_record begin "$rollback_guard" --action rollback --backup "$backup" >/dev/null

  [[ -f "$DEPLOY_CODE" ]] \
    && cp -p "$DEPLOY_CODE" "$rollback_guard/seminartext_4.0_work"
  [[ -f "$DEPLOY_ROADMAP" ]] \
    && cp -p "$DEPLOY_ROADMAP" "$rollback_guard/SEMINARTEXT_4_ROADMAP.md"
  [[ -f "$DEPLOY_STATE" ]] \
    && cp -p "$DEPLOY_STATE" "$rollback_guard/SEMINARTEXT_4_STATE.json"
  [[ -f "$DEPLOY_TOPICS" ]] \
    && cp -p "$DEPLOY_TOPICS" "$rollback_guard/seminartext_topics.py"
  [[ -f "$DEPLOY_TRANSLATE" ]] \
    && cp -p "$DEPLOY_TRANSLATE" "$rollback_guard/seminartext_translate.py"
  [[ -f "$DEPLOY_EVIDENCE_FOUNDATION" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_EVIDENCE_FOUNDATION" "$rollback_guard/seminartext_modules/evidence_foundation.py"; }
  [[ -f "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE" "$rollback_guard/seminartext_modules/project_knowledge_bridge.py"; }
  [[ -f "$DEPLOY_HUMAN_REVIEW_WORKFLOW" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_HUMAN_REVIEW_WORKFLOW" "$rollback_guard/seminartext_modules/human_review_workflow.py"; }
  [[ -f "$DEPLOY_OWNED_TMP" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_OWNED_TMP" "$rollback_guard/seminartext_modules/owned_tmp.py"; }
  [[ -f "$DEPLOY_GROUP_SOURCES" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_GROUP_SOURCES" "$rollback_guard/seminartext_modules/group_sources.py"; }
  [[ -f "$DEPLOY_ASR_COMPLETION" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_ASR_COMPLETION" "$rollback_guard/seminartext_modules/asr_completion.py"; }
  [[ -f "$DEPLOY_CANONICAL_VALIDATOR" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_CANONICAL_VALIDATOR" "$rollback_guard/schemas/validate_canonical_evidence_v1.py"; }
  [[ -f "$DEPLOY_CANONICAL_SCHEMA" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_CANONICAL_SCHEMA" "$rollback_guard/schemas/canonical_evidence_v1.schema.json"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR" "$rollback_guard/schemas/validate_canonical_knowledge_v1.py"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA" "$rollback_guard/schemas/canonical_knowledge_v1.schema.json"; }
  [[ -f "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE" "$rollback_guard/schemas/canonical_knowledge_lifecycle_v1.json"; }
  [[ -f "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA" "$rollback_guard/schemas/project_knowledge_input_v1.schema.json"; }
  [[ -f "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA" "$rollback_guard/schemas/topic_review_workflow_v1.schema.json"; }
  [[ -f "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" ]] \
    && { mkdir -p "$rollback_guard/schemas"; cp -p "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2" "$rollback_guard/schemas/topic_review_workflow_v2.schema.json"; }
  [[ -f "$DEPLOY_DATASET_GOVERNANCE" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_DATASET_GOVERNANCE" "$rollback_guard/seminartext_modules/dataset_governance.py"; }
  [[ -f "$DEPLOY_DATASET_REGISTRY" ]] \
    && { mkdir -p "$rollback_guard/governance"; cp -p "$DEPLOY_DATASET_REGISTRY" "$rollback_guard/governance/dataset_registry.json"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" ]] \
    && { mkdir -p "$rollback_guard/seminartext_modules"; cp -p "$DEPLOY_TOPIC_ENGINE_GOVERNANCE" "$rollback_guard/seminartext_modules/topic_engine_governance.py"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" ]] \
    && { mkdir -p "$rollback_guard/governance"; cp -p "$DEPLOY_TOPIC_ENGINE_LIFECYCLE" "$rollback_guard/governance/topic_engine_lifecycle.json"; }
  [[ -f "$DEPLOY_TOPIC_ENGINE_FREEZE" ]] \
    && { mkdir -p "$rollback_guard/governance"; cp -p "$DEPLOY_TOPIC_ENGINE_FREEZE" "$rollback_guard/governance/topic_engine_freeze.json"; }
  [[ -f "$DEPLOY_VERSION" ]] \
    && cp -p "$DEPLOY_VERSION" "$rollback_guard/SEMINARTEXT_VERSION"

  local tmp_code tmp_roadmap tmp_state tmp_topics="" tmp_translate="" tmp_evidence_foundation="" tmp_project_knowledge_bridge="" tmp_human_review_workflow="" tmp_owned_tmp="" tmp_group_sources="" tmp_asr_completion="" tmp_canonical_validator="" tmp_canonical_schema="" tmp_canonical_knowledge_validator="" tmp_canonical_knowledge_schema="" tmp_canonical_knowledge_lifecycle="" tmp_project_knowledge_input_schema="" tmp_topic_review_workflow_schema="" tmp_topic_review_workflow_schema_v2="" tmp_dataset_governance="" tmp_dataset_registry="" tmp_topic_engine_governance="" tmp_topic_engine_lifecycle="" tmp_topic_engine_freeze="" tmp_version=""
  tmp_code="$DEPLOY_CODE.rollback.$$"
  tmp_roadmap="$DEPLOY_ROADMAP.rollback.$$"
  tmp_state="$DEPLOY_STATE.rollback.$$"

  cp -p "$backup_code" "$tmp_code"
  cp -p "$backup_roadmap" "$tmp_roadmap"
  cp -p "$backup_state" "$tmp_state"
  if [[ -f "$backup_topics" ]]; then
    tmp_topics="$DEPLOY_TOPICS.rollback.$$"
    cp -p "$backup_topics" "$tmp_topics"
  fi
  if [[ -f "$backup_translate" ]]; then
    tmp_translate="$DEPLOY_TRANSLATE.rollback.$$"
    cp -p "$backup_translate" "$tmp_translate"
  fi
  if [[ -f "$backup_evidence_foundation" ]]; then
    tmp_evidence_foundation="$DEPLOY_EVIDENCE_FOUNDATION.rollback.$$"
    mkdir -p "$(dirname "$tmp_evidence_foundation")"
    cp -p "$backup_evidence_foundation" "$tmp_evidence_foundation"
  fi
  if [[ -f "$backup_project_knowledge_bridge" ]]; then
    tmp_project_knowledge_bridge="$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE.rollback.$$"
    mkdir -p "$(dirname "$tmp_project_knowledge_bridge")"
    cp -p "$backup_project_knowledge_bridge" "$tmp_project_knowledge_bridge"
  fi
  if [[ -f "$backup_human_review_workflow" ]]; then
    tmp_human_review_workflow="$DEPLOY_HUMAN_REVIEW_WORKFLOW.rollback.$$"
    mkdir -p "$(dirname "$tmp_human_review_workflow")"
    cp -p "$backup_human_review_workflow" "$tmp_human_review_workflow"
  fi
  if [[ -f "$backup_owned_tmp" ]]; then
    tmp_owned_tmp="$DEPLOY_OWNED_TMP.rollback.$$"
    mkdir -p "$(dirname "$tmp_owned_tmp")"
    cp -p "$backup_owned_tmp" "$tmp_owned_tmp"
  fi
  if [[ -f "$backup_group_sources" ]]; then
    tmp_group_sources="$DEPLOY_GROUP_SOURCES.rollback.$$"
    mkdir -p "$(dirname "$tmp_group_sources")"
    cp -p "$backup_group_sources" "$tmp_group_sources"
  fi
  if [[ -f "$backup_asr_completion" ]]; then
    tmp_asr_completion="$DEPLOY_ASR_COMPLETION.rollback.$$"
    mkdir -p "$(dirname "$tmp_asr_completion")"
    cp -p "$backup_asr_completion" "$tmp_asr_completion"
  elif [[ -f "$backup/ASR_COMPLETION_ABSENT" ]]; then
    tmp_asr_completion="$DEPLOY_ASR_COMPLETION.rollback-absent.$$"
  fi
  if [[ -f "$backup_canonical_validator" ]]; then
    tmp_canonical_validator="$DEPLOY_CANONICAL_VALIDATOR.rollback.$$"
    mkdir -p "$(dirname "$tmp_canonical_validator")"
    cp -p "$backup_canonical_validator" "$tmp_canonical_validator"
  fi
  if [[ -f "$backup_canonical_schema" ]]; then
    tmp_canonical_schema="$DEPLOY_CANONICAL_SCHEMA.rollback.$$"
    mkdir -p "$(dirname "$tmp_canonical_schema")"
    cp -p "$backup_canonical_schema" "$tmp_canonical_schema"
  fi
  if [[ -f "$backup_canonical_knowledge_validator" ]]; then
    tmp_canonical_knowledge_validator="$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR.rollback.$$"
    mkdir -p "$(dirname "$tmp_canonical_knowledge_validator")"
    cp -p "$backup_canonical_knowledge_validator" "$tmp_canonical_knowledge_validator"
  fi
  if [[ -f "$backup_canonical_knowledge_schema" ]]; then
    tmp_canonical_knowledge_schema="$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA.rollback.$$"
    mkdir -p "$(dirname "$tmp_canonical_knowledge_schema")"
    cp -p "$backup_canonical_knowledge_schema" "$tmp_canonical_knowledge_schema"
  fi
  if [[ -f "$backup_canonical_knowledge_lifecycle" ]]; then
    tmp_canonical_knowledge_lifecycle="$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE.rollback.$$"
    mkdir -p "$(dirname "$tmp_canonical_knowledge_lifecycle")"
    cp -p "$backup_canonical_knowledge_lifecycle" "$tmp_canonical_knowledge_lifecycle"
  fi
  if [[ -f "$backup_project_knowledge_input_schema" ]]; then
    tmp_project_knowledge_input_schema="$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA.rollback.$$"
    mkdir -p "$(dirname "$tmp_project_knowledge_input_schema")"
    cp -p "$backup_project_knowledge_input_schema" "$tmp_project_knowledge_input_schema"
  fi
  if [[ -f "$backup_topic_review_workflow_schema" ]]; then
    tmp_topic_review_workflow_schema="$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA.rollback.$$"
    mkdir -p "$(dirname "$tmp_topic_review_workflow_schema")"
    cp -p "$backup_topic_review_workflow_schema" "$tmp_topic_review_workflow_schema"
  fi
  if [[ -f "$backup_topic_review_workflow_schema_v2" ]]; then
    tmp_topic_review_workflow_schema_v2="$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2.rollback.$$"
    mkdir -p "$(dirname "$tmp_topic_review_workflow_schema_v2")"
    cp -p "$backup_topic_review_workflow_schema_v2" "$tmp_topic_review_workflow_schema_v2"
  fi
  if [[ -f "$backup_dataset_governance" ]]; then
    tmp_dataset_governance="$DEPLOY_DATASET_GOVERNANCE.rollback.$$"
    mkdir -p "$(dirname "$tmp_dataset_governance")"
    cp -p "$backup_dataset_governance" "$tmp_dataset_governance"
  fi
  if [[ -f "$backup_dataset_registry" ]]; then
    tmp_dataset_registry="$DEPLOY_DATASET_REGISTRY.rollback.$$"
    mkdir -p "$(dirname "$tmp_dataset_registry")"
    cp -p "$backup_dataset_registry" "$tmp_dataset_registry"
  fi
  if [[ -f "$backup_topic_engine_governance" ]]; then
    tmp_topic_engine_governance="$DEPLOY_TOPIC_ENGINE_GOVERNANCE.rollback.$$"
    mkdir -p "$(dirname "$tmp_topic_engine_governance")"
    cp -p "$backup_topic_engine_governance" "$tmp_topic_engine_governance"
  fi
  if [[ -f "$backup_topic_engine_lifecycle" ]]; then
    tmp_topic_engine_lifecycle="$DEPLOY_TOPIC_ENGINE_LIFECYCLE.rollback.$$"
    mkdir -p "$(dirname "$tmp_topic_engine_lifecycle")"
    cp -p "$backup_topic_engine_lifecycle" "$tmp_topic_engine_lifecycle"
  fi
  if [[ -f "$backup_topic_engine_freeze" ]]; then
    tmp_topic_engine_freeze="$DEPLOY_TOPIC_ENGINE_FREEZE.rollback.$$"
    mkdir -p "$(dirname "$tmp_topic_engine_freeze")"
    cp -p "$backup_topic_engine_freeze" "$tmp_topic_engine_freeze"
  fi
  if [[ -f "$backup_version" ]]; then
    tmp_version="$DEPLOY_VERSION.rollback.$$"
    cp -p "$backup_version" "$tmp_version"
  fi

  chmod +x "$tmp_code"
  [[ -z "$tmp_topics" ]] || chmod +x "$tmp_topics"
  [[ -z "$tmp_translate" ]] || chmod +x "$tmp_translate"

  mv "$tmp_code" "$DEPLOY_CODE"
  mv "$tmp_roadmap" "$DEPLOY_ROADMAP"
  mv "$tmp_state" "$DEPLOY_STATE"
  [[ -z "$tmp_topics" ]] || mv "$tmp_topics" "$DEPLOY_TOPICS"
  [[ -z "$tmp_translate" ]] || mv "$tmp_translate" "$DEPLOY_TRANSLATE"
  [[ -z "$tmp_evidence_foundation" ]] || mv "$tmp_evidence_foundation" "$DEPLOY_EVIDENCE_FOUNDATION"
  [[ -z "$tmp_project_knowledge_bridge" ]] || mv "$tmp_project_knowledge_bridge" "$DEPLOY_PROJECT_KNOWLEDGE_BRIDGE"
  [[ -z "$tmp_human_review_workflow" ]] || mv "$tmp_human_review_workflow" "$DEPLOY_HUMAN_REVIEW_WORKFLOW"
  [[ -z "$tmp_owned_tmp" ]] || mv "$tmp_owned_tmp" "$DEPLOY_OWNED_TMP"
  [[ -z "$tmp_group_sources" ]] || mv "$tmp_group_sources" "$DEPLOY_GROUP_SOURCES"
  if [[ "$tmp_asr_completion" == *".rollback-absent."* ]]; then
    rm -f "$DEPLOY_ASR_COMPLETION"
  elif [[ -n "$tmp_asr_completion" ]]; then
    mv "$tmp_asr_completion" "$DEPLOY_ASR_COMPLETION"
  fi
  [[ -z "$tmp_canonical_validator" ]] || mv "$tmp_canonical_validator" "$DEPLOY_CANONICAL_VALIDATOR"
  [[ -z "$tmp_canonical_schema" ]] || mv "$tmp_canonical_schema" "$DEPLOY_CANONICAL_SCHEMA"
  [[ -z "$tmp_canonical_knowledge_validator" ]] || mv "$tmp_canonical_knowledge_validator" "$DEPLOY_CANONICAL_KNOWLEDGE_VALIDATOR"
  [[ -z "$tmp_canonical_knowledge_schema" ]] || mv "$tmp_canonical_knowledge_schema" "$DEPLOY_CANONICAL_KNOWLEDGE_SCHEMA"
  [[ -z "$tmp_canonical_knowledge_lifecycle" ]] || mv "$tmp_canonical_knowledge_lifecycle" "$DEPLOY_CANONICAL_KNOWLEDGE_LIFECYCLE"
  [[ -z "$tmp_project_knowledge_input_schema" ]] || mv "$tmp_project_knowledge_input_schema" "$DEPLOY_PROJECT_KNOWLEDGE_INPUT_SCHEMA"
  [[ -z "$tmp_topic_review_workflow_schema" ]] || mv "$tmp_topic_review_workflow_schema" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA"
  [[ -z "$tmp_topic_review_workflow_schema_v2" ]] || mv "$tmp_topic_review_workflow_schema_v2" "$DEPLOY_TOPIC_REVIEW_WORKFLOW_SCHEMA_V2"
  [[ -z "$tmp_dataset_governance" ]] || mv "$tmp_dataset_governance" "$DEPLOY_DATASET_GOVERNANCE"
  [[ -z "$tmp_dataset_registry" ]] || mv "$tmp_dataset_registry" "$DEPLOY_DATASET_REGISTRY"
  [[ -z "$tmp_topic_engine_governance" ]] || mv "$tmp_topic_engine_governance" "$DEPLOY_TOPIC_ENGINE_GOVERNANCE"
  [[ -z "$tmp_topic_engine_lifecycle" ]] || mv "$tmp_topic_engine_lifecycle" "$DEPLOY_TOPIC_ENGINE_LIFECYCLE"
  [[ -z "$tmp_topic_engine_freeze" ]] || mv "$tmp_topic_engine_freeze" "$DEPLOY_TOPIC_ENGINE_FREEZE"
  [[ -z "$tmp_version" ]] || mv "$tmp_version" "$DEPLOY_VERSION"

  local registry_result registry_code=0
  registry_result="$(activation_record rollback-complete "$rollback_guard")" || registry_code=$?
  if [[ "$registry_code" -eq 2 ]]; then
    echo "ROLLBACK: INCOMPLETE"
  else
    echo "ROLLBACK: PASS"
  fi
  echo "Restored: $backup"
  [[ -z "$registry_result" ]] || printf '%s\n' "$registry_result"
  case "$registry_code" in
    0) echo "REGISTRY: VERIFIED" ;;
    3)
      if [[ "$registry_result" == *'"status": "RECONCILIATION_REQUIRED"'* ]]; then
        echo "REGISTRY: RECONCILIATION_REQUIRED"
      else
        echo "REGISTRY: PUBLICATION_PENDING"
      fi
      ;;
    *) echo "REGISTRY: RECONCILIATION_REQUIRED; native verification incomplete" ;;
  esac
  if [[ ! -f "$backup_owned_tmp" || ! -f "$backup_group_sources" || ( ! -f "$backup_asr_completion" && ! -f "$backup/ASR_COMPLETION_ABSENT" ) || ! -f "$backup_topics" || ! -f "$backup_translate" || ! -f "$backup_evidence_foundation" || ! -f "$backup_project_knowledge_bridge" || ! -f "$backup_human_review_workflow" || ! -f "$backup_canonical_validator" || ! -f "$backup_canonical_schema" || ! -f "$backup_canonical_knowledge_validator" || ! -f "$backup_canonical_knowledge_schema" || ! -f "$backup_canonical_knowledge_lifecycle" || ! -f "$backup_project_knowledge_input_schema" || ! -f "$backup_topic_review_workflow_schema" || ! -f "$backup_topic_review_workflow_schema_v2" || ! -f "$backup_dataset_governance" || ! -f "$backup_dataset_registry" || ! -f "$backup_topic_engine_governance" || ! -f "$backup_topic_engine_lifecycle" || ! -f "$backup_topic_engine_freeze" || ! -f "$backup_version" ]]; then
    echo "Legacy backup: отсутствующие runtime/version-файлы оставлены без изменения."
  fi
  echo "Previous deployed state saved:"
  echo "$rollback_guard"
  return "$registry_code"
}

show_help() {
  cat <<'HELP'
Использование:

  scripts/seminartext-dev status

      Показывает Git source of truth, master/deployed hashes для Code,
      Roadmap, State, runtime-модулей и Version, а также sync status.

  scripts/seminartext-dev check

      Read-only проверяет master code, runtime-модули, State schema/version,
      структуру Roadmap и governance consistency.

  scripts/seminartext-dev checkpoint "MESSAGE" FILE [FILE ...]

      Создаёт commit только для явно перечисленных tracked-файлов.
      Не добавляет случайные untracked-файлы.

  scripts/seminartext-dev deploy

      Выполняет check, запрещает deploy при tracked dirty state,
      создаёт backup ~/bin, атомарно разворачивает master-файлы
      и проверяет SHA-256.

  scripts/seminartext-dev deploy --complete

      После разрешённого deploy выполняет существующие post-deploy Integrity
      и full tests, сохраняет native receipt и вызывает центральный publisher.
      Exit 3 означает PUBLICATION_PENDING, а не неудачный deployment.

  scripts/seminartext-dev activation-complete BACKUP_PATH

      Завершает post-checks инструментированного deploy без повторной установки.

  scripts/seminartext-dev registry-retry BACKUP_PATH

      Повторяет только публикацию сохранённого события; не deploy и не tests.

  scripts/seminartext-dev rollback list

      Показывает доступные deploy-backups.

  scripts/seminartext-dev rollback latest

      Восстанавливает последний deploy-backup.

  scripts/seminartext-dev rollback BACKUP

      Восстанавливает конкретный backup. После проверки точных восстановленных
      байтов публикует только доказанный исторический rollback; exit 3 означает
      RECONCILIATION_REQUIRED либо PUBLICATION_PENDING, без повторного rollback.
HELP
}

case "${1:-}" in
  status)
    cmd_status
    ;;
  check)
    cmd_check
    ;;
  checkpoint)
    shift
    cmd_checkpoint "$@"
    ;;
  deploy)
    [[ $# -eq 1 || ( $# -eq 2 && "$2" == "--complete" ) ]] || die "deploy: expected optional --complete"
    cmd_deploy
    if [[ "${2:-}" == "--complete" ]]; then
      activation_record complete "$LAST_DEPLOY_BACKUP"
    fi
    ;;
  activation-complete|registry-retry)
    [[ $# -eq 2 && -d "$2" ]] || die "$1: exact operation directory required"
    require_repo
    if [[ "$1" == "activation-complete" ]]; then
      activation_record complete "$2"
    else
      activation_record retry "$2"
    fi
    ;;
  rollback)
    shift
    cmd_rollback "$@"
    ;;
  -h|--help|help|"")
    show_help
    ;;
  *)
    die "неизвестная команда: $1"
    ;;
esac
